[
  {
    "name": "Responses AI 题库（浏览器取图）",
    "homepage": "https://your-service.example.com/health",
    "url": "https://your-service.example.com/v1/answer",
    "method": "post",
    "contentType": "json",
    "type": "GM_xmlhttpRequest",
    "headers": {
      "Content-Type": "application/json",
      "X-Access-Token": "change-me"
    },
    "data": {
      "title": "${title}",
      "options": "${options}",
      "option_items": {
        "handler": "return (env) => Array.isArray(env.option_items) ? env.option_items : []"
      },
      "type": "${type}",
      "images": {
        "handler": "return async (env) => { const re = /https?:\\/\\/[^\\s<>\\\"'\\])}，。；;]+/gi; const refs = []; const titleUrls = String(env.title || '').match(re) || []; titleUrls.forEach((url, i) => refs.push({ label: `题干/材料图片 ${i + 1}`, source_url: url })); const optionItems = Array.isArray(env.option_items) ? env.option_items : String(env.options || '').split(/\\r?\\n/).filter(Boolean); optionItems.forEach((option, oi) => { const urls = String(option).match(re) || []; const letter = oi < 26 ? String.fromCharCode(65 + oi) : String(oi + 1); urls.forEach((url, ii) => refs.push({ label: `选项 ${letter} 图片 ${ii + 1}`, source_url: url })); }); const load = (item) => new Promise((resolve) => { GM_xmlhttpRequest({ method: 'GET', url: item.source_url, responseType: 'arraybuffer', anonymous: false, onload: (res) => { try { if (res.status < 200 || res.status >= 300 || !res.response) return resolve(null); const match = String(res.responseHeaders || '').match(/^content-type:\\s*([^;\\r\\n]+)/im); const mime = match ? match[1] : 'image/png'; const bytes = new Uint8Array(res.response); let binary = ''; for (let i = 0; i < bytes.length; i += 32768) binary += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + 32768))); resolve({ ...item, data_url: `data:${mime};base64,${btoa(binary)}` }); } catch (_) { resolve(null); } }, onerror: () => resolve(null), ontimeout: () => resolve(null), timeout: 20000 }); }); return (await Promise.all(refs.slice(0, 24).map(load))).filter(Boolean); }"
      }
    },
    "handler": "return (res) => res.code === 1 ? [res.question, res.answer, { confidence: res.confidence, model: res.model, warnings: res.warnings }] : [res.message || 'Responses AI 题库请求失败', undefined]"
  }
]
